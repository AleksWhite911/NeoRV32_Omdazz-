bool init_module(void) {
	neorv32_rte_setup();
	//uint32_t irq_set = 1LL << SDI_CTRL_IRQ_RX_NEMPTY;

	if (!status_struct.uart_0) {
		return false;
	} else {
		neorv32_uart0_setup(BAUD_RATE, 0);
		neorv32_uart0_printf("UART_0 - Init successful\n");
	}

	if (!status_struct.uart_1) {
		neorv32_uart0_printf("UART_1 - Not implement \n");
	} else {
		neorv32_uart1_setup(BAUD_RATE, 0);
		neorv32_uart0_printf("UART_1 - Init successful\n");
	}


	if (!status_struct.sdi) {
		neorv32_uart0_printf("SDI - Not implement or another mode SDI");
		return false;
	} else {
		neorv32_sdi_setup(0);
		neorv32_uart0_printf("");
	}

	if (!status_struct.sdi_std_mode) {
		neorv32_uart0_printf("SDI_STD - SDI_Controller is not implement!\n");
	} else {
		STD_Protocol_Run();
	}

	#if defined(SDI_INTERRUPT)
		if (!status_struct.sdi) {
			neorv32_uart0_printf("SDI init false!");
			return false;
		} else {
			neorv32_sdi_setup(irq_set);
			neorv32_rte_handler_install(SDI_TRAP_CODE, STD_Timer_Start);
			neorv32_cpu_csr_set(CSR_MIE, 1 << SDI_FIRQ_ENABLE);
			  neorv32_cpu_csr_set(CSR_MSTATUS, 1 << CSR_MSTATUS_MIE);
			neorv32_uart0_printf("SDI_Controller and interrupt init success!");
		}
	#endif


	return true;

}
