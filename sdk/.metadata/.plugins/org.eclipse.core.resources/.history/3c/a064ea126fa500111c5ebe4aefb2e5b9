#include "i2c_driver.h"


void scan_twi(void) {

  uint8_t i;
  int num_devices = 0, twi_ack = 0;

  neorv32_uart0_printf("Scanning TWI bus...\n");

  for (i=0; i<128; i++) {
    neorv32_twi_generate_start();
    uint8_t tmp = (i << 1) + 1;	//shift addr_reg + Read bit
    twi_ack = neorv32_twi_transfer(&tmp, 0);
    neorv32_twi_generate_stop();

    if (twi_ack == 0) {
      neorv32_uart0_printf(" + Found device at write-address 0x");
      print_hex_byte(i << 1);
      neorv32_uart0_printf("\n");
      num_devices++;
    }
  }

  if (num_devices == 0) {
    neorv32_uart0_printf("No devices found.\n");
  }
  else {
    neorv32_uart0_printf("Devices found: %i\n", num_devices);
  }
}

void i2c_write_byte(uint8_t data, uint8_t device_address, uint8_t word_address) {
	uint8_t command;
	uint8_t ack_get;
	uint32_t dummy_delay = 20;
	command = device_address & MASK_WRITE;
	neorv32_twi_generate_start();
	ack_get = neorv32_twi_transfer(&command, 0);
	if (ack_get == 0) {
		ack_get = neorv32_twi_transfer(&word_address, 0);	//word address
	}
	if (ack_get == 0) {
		ack_get = neorv32_twi_transfer(&data, 0);
			neorv32_twi_generate_stop();
	}
	neorv32_aux_delay_ms(CPU_CLOCK, dummy_delay);

}

uint8_t i2c_read_byte(uint8_t device_address, uint8_t word_address) {
	uint8_t dummy_data = 0xFF;
	uint8_t data = 0xFF;
	uint8_t command;
	uint8_t ack_get;
	int status_fifo = 0;
	neorv32_twi_generate_start();
	command = device_address & MASK_WRITE;
	ack_get = neorv32_twi_transfer(&command, 0);
	if (ack_get == 0) {
		ack_get = neorv32_twi_transfer(&word_address, 0);
	}
	else {
		neorv32_uart0_printf("I2C - False Device Address Write Operation!\n");
		return 0;
	}

	if (ack_get == 0) {
		neorv32_twi_generate_start();
		command = device_address | MASK_READ;	//READ OPERATION
		ack_get = neorv32_twi_transfer(&command,1);
		ack_get = neorv32_twi_transfer(&data, 0);
		neorv32_twi_generate_stop();


	}
	else {
		neorv32_uart0_printf("I2C - False Word Address Write Operation!\n");
		return 0;
	}

	return data;
}

uint8_t i2c_read_temp_byte(uint8_t device_address, uint8_t word_address) {
	uint8_t data = 0xFF;
	uint8_t command;
	uint8_t ack_get;
	int status_fifo = 0;
	neorv32_twi_generate_start();
	command = device_address | MASK_WRITE;	//WRITE OPERATION
	ack_get = neorv32_twi_transfer(&command, 0);
	ack_get = neorv32_twi_transfer(&word_address, 0);

	neorv32_twi_generate_start();
	command = device_address | MASK_READ;	//READ OPERATION
	ack_get = neorv32_twi_transfer(&command, 1);
	ack_get = neorv32_twi_transfer(&data, 0);
	neorv32_twi_generate_stop();

	return data;
}

void i2c_write_word(uint32_t data, uint8_t device_address, uint8_t word_address) {
	uint8_t first_big_byte = data >> 24;
	uint8_t second_big_byte = data >> 16;
	uint8_t third_big_byte = data >> 8;
	uint8_t little_byte = data;
	print_hex_byte(first_big_byte);
	print_hex_byte(second_big_byte);
	print_hex_byte(third_big_byte);
	print_hex_byte();

	i2c_write_byte(first_big_byte, device_address, word_address);
	i2c_write_byte(second_big_byte, device_address, word_address+1);
	i2c_write_byte(third_big_byte, device_address, word_address+2);
	i2c_write_byte(little_byte, device_address, word_address+3);
}
