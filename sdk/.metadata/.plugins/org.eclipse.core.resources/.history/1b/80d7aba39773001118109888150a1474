int STD_SPI_Init(void) {
	uint32_t Status;
	uint32_t irq_set = 1LL << SDI_CTRL_IRQ_RX_NEMPTY;
	if (!status_struct.sdi_std_mode) {
		return false;
	} else {
		neorv32_sdi_setup(irq_set);
		neorv32_rte_handler_install(SDI_TRAP_CODE, STD_Handler);
		neorv32_cpu_csr_set(CSR_MIE, 1 << SDI_FIRQ_ENABLE);
		neorv32_cpu_csr_set(CSR_MSTATUS, 1 << CSR_MSTATUS_MIE);
	}
}

/*******************************************
 * Read data from control SPI
 ******************************************/
uint16_t STD_SPI_Read(void) {
    uint8_t  data;
    if (!neorv32_sdi_rx_empty()) {
    	data = neorv32_sdi_get_nonblocking();
    	return data;
    }
    else return 0;
}

/*******************************************
 * Write data to control SPI
 ******************************************/
void STD_SPI_Write(uint16_t data) {
	uint32_t controlReg;
	if (!neorv32_sdi_tx_full()) {
		neorv32_sdi_put(data);
	}

}

/*******************************************
 * Have receive data in control SPI?
 ******************************************/
bool STD_SPI_HaveData(void) {
	if (!neorv32_sdi_rx_empty())
		return true;
	else
		return false;
}

/*******************************************
 * Can transmit data to control SPI?
 ******************************************/
bool STD_SPI_CanTransmit(void) {
	if (!neorv32_sdi_check_cs()) {
		return true;
	}
	else false;
}

