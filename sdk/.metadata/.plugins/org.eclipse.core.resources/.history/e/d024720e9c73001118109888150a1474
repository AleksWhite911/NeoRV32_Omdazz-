Declare instance and associated pointer for
 ******************************************/
stdChannel_s stdChSpi;

/*******************************************
 * Private function prototypes
 ******************************************/
bool     Ch_HaveData   (void);
uint16_t Ch_GetData    (void);
bool     Ch_CanTransmit(void);
void     Ch_PutData    (uint16_t data);
void     Ch_RunCommand (uint16_t cmd, uint16_t *rxData, uint16_t *txData);
void     STD_TimerInit (uint32_t value);
void     STD_TimerStart(void);
void     STD_TimerStop (void);

/*******************************************
 * Initialization external communication
 ******************************************/
void STD_Protocol_Setup(void) {
    stdChSpi.data_size       = STD_DATA_SIZE_8_BIT;

    stdChSpi.STD_HaveData    = STD_SPI_HaveData;
    stdChSpi.STD_GetData     = STD_SPI_Read;
    stdChSpi.STD_CanTransmit = STD_SPI_CanTransmit;
    stdChSpi.STD_PutData     = STD_SPI_Write;
    stdChSpi.STD_Run         = Ch_RunCommand;


    stdChSpi.STD_TimerInit   = STD_TimerInit;
    stdChSpi.STD_TimerStart  = STD_TimerStart;
    stdChSpi.STD_TimerStop   = STD_TimerStop;
    stdChSpi.timeout_value   = STD_TIMER_LOAD_VALUE;
    stdChSpi.timer_en        = false;

    STD_Init(&stdChSpi);
}
/*******************************************
 * Run STD Protocol
 ******************************************/
int  STD_Protocol_Run(void){
    bool Status;

    Status = STD_SPI_Init();
	STD_Protocol_Setup();

	//STD_TimerInit(STD_TIMER_LOAD_VALUE);			//STD_Protocol_Setup
	//STD_TimerStart();

	return Status;
}
/*******************************************
 * STD_Process Handler
 ******************************************/
void STD_Handler(void){

	STD_Process(&stdChSpi);
}
