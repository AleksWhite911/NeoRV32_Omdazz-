/**********************************************************************//**
 * @file demo_cfu/main.c
 * @brief Example program showing how to use the CFU's custom instructions
 * (XTEA example). Take a look at the commented "hardware-counterpart" of
 * this CFU example in 'rtl/core/neorv32_cpu_cp_cfu.vhd'.
 **************************************************************************/
#include <neorv32.h>


/**********************************************************************//**
 * @name User configuration
 **************************************************************************/
/**@{*/
/** UART BAUD rate */
#define BAUD_RATE   9600
/** Number of XTEA rounds */
#define XTEA_ROUNDS 20
/** Input data size (number of 32-bit words), has to be even */
#define DATA_NUM    64
/**@}*/


uint32_t spi_configured;

/**********************************************************************//**
 * Main function: run pure-SW XTEA and compare with HW-accelerated XTEA
 *
 * @note This program requires UART0 and the Xcfu and Zicntr ISA extension.
 *
 * @return 0 if execution was successful
 **************************************************************************/
int main() {

  uint32_t i, j;
  uint32_t v[2];
  // initialize NEORV32 run-time environment
  neorv32_rte_setup();

  // check if UART0 is implemented
  if (neorv32_uart0_available() == 0) {
    return -1; // UART0 not available, exit
  }

  // setup UART0 at default baud rate, no interrupts
  neorv32_uart0_setup(BAUD_RATE, 0);

  if (neorv32_sdi_available() == 0) {
    neorv32_uart0_printf("ERROR! No SPI unit implemented.");
    return 1;
  }

  neorv32_sdi_setup(0); // no interrupts


  neorv32_uart0_printf("\nNEORV32 demo blink\n");
  while(1) {
  //Check gpio block
	  if (neorv32_gpio_available > 0) {
		  neorv32_gpio_pin_toggle(0);
		  neorv32_aux_delay_ms(27000000, 1000);
		  neorv32_gpio_pin_toggle(0);
		  neorv32_aux_delay_ms(27000000, 1000);
	  }

	  if (neorv32_sdi_rx_empty()) {
	    neorv32_uart0_printf("No RX data available (RX buffer is empty).\n");
	  }
	  else {
		  uint8_t check = neorv32_sdi_rx_empty();
		  neorv32_uart0_printf("Read data: 0x%x\n", (uint32_t)neorv32_sdi_get_nonblocking());
	  }
  }

}
